# Optional default Last.fm API key (users never need to enter one if set here)
VITE_LASTFM_API_KEY=

# Optional donation links (LivePix is recommended in Brazil to keep your personal CPF private)
VITE_LIVEPIX_URL=
VITE_KOFI_URL=
VITE_PIX_KEY=

# Optional public GitHub repository URL for Open Source transparency badge
VITE_GITHUB_URL=

# Toggle lightweight sponsor/ad slot in footer ("true" or "false")
VITE_ADS_ENABLED=false
